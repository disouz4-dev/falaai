# PT-BR: Arquivos ignorados pelo git. EN: Git-ignored files.
.venv/
certs/
__pycache__/
*.pyc
.DS_Store
# PT-BR: banco local com dados do aluno (perfil/progresso). EN: local user-data DB.
backend/data/*.db
# PT-BR: vozes do Piper (grandes; baixadas pelo setup). EN: Piper voices (large; downloaded by setup).
backend/voices/
# PT-BR: artefatos de build do desktop. EN: desktop build artifacts.
desktop/dist/
desktop/node_modules/
# PT-BR: CA local do mkcert (por máquina). EN: local mkcert CA (per machine).
web/public/guaralingo-ca.crt
# PT-BR: vault de memoria do aluno (dados pessoais). EN: student memory vault (personal data).
backend/data/memory/

# PT-BR: React/Vite. EN: React/Vite.
web/node_modules/
web/dist/
# PT-BR: build do Tauri que é copiado para dentro do bundle. EN: Tauri build copied into the bundle.
web/src-tauri/dist/
# PT-BR: pacotes instaláveis gerados (release). EN: generated installer packages (release).
web/*.deb
